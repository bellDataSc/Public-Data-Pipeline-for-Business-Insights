# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your specific values
# DO NOT commit the .env file to version control for security

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Environment: development, staging, production
ENV=development

# Application name and version
APP_NAME=public-data-pipeline
APP_VERSION=1.0.0

# Debug mode (true/false)
DEBUG=true

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/public_data

# Individual database components (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=public_data
DB_USER=user
DB_PASSWORD=password

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION (for caching and task queues)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cache settings
CACHE_TTL=3600
CACHE_DEFAULT_TIMEOUT=300

# =============================================================================
# API KEYS AND EXTERNAL SERVICES
# =============================================================================

# IBGE API Configuration
IBGE_API_BASE_URL=https://servicodados.ibge.gov.br/api/v1
IBGE_API_KEY=your_ibge_api_key_here
IBGE_RATE_LIMIT=100
IBGE_TIMEOUT=30

# SICONV API (Brazilian Federal Government Transfers)
SICONV_API_BASE_URL=https://api.siconv.gov.br
SICONV_API_KEY=your_siconv_api_key_here
SICONV_RATE_LIMIT=50
SICONV_TIMEOUT=30

# =============================================================================
# CLOUD SERVICES CONFIGURATION
# =============================================================================

# Google Cloud Platform
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# BigQuery settings
BIGQUERY_DATASET=public_data_pipeline
BIGQUERY_LOCATION=US
BIGQUERY_TABLE_PREFIX=pdt_

# Google Cloud Storage
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_DATA_PATH=data/

# AWS Configuration (if using AWS services)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# =============================================================================
# DATA PIPELINE CONFIGURATION
# =============================================================================

# Data directories
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
OUTPUT_DATA_DIR=./data/output
TEMP_DATA_DIR=./data/temp
LOGS_DIR=./logs

# Pipeline execution settings
PIPELINE_BATCH_SIZE=1000
PIPELINE_MAX_WORKERS=4
PIPELINE_RETRY_ATTEMPTS=3
PIPELINE_RETRY_DELAY=60
PIPELINE_TIMEOUT=3600

# Data quality settings
DATA_QUALITY_THRESHOLD=0.95
MISSING_DATA_THRESHOLD=0.1
OUTLIER_DETECTION_THRESHOLD=3.0

# =============================================================================
# WEB APPLICATION SETTINGS
# =============================================================================

# FastAPI settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_WORKERS=1

# Streamlit dashboard settings
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# CORS settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE
CORS_ALLOW_HEADERS=*

# =============================================================================
# MONITORING AND LOGGING
# =============================================================================

# Prometheus metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana dashboard
GRAFANA_ENABLED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Structured logging
LOG_FORMAT=json
LOG_FILE_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5
LOG_ROTATION_TIME=24h

# Health check settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_ENDPOINT=/health
HEALTH_CHECK_TIMEOUT=30

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# JWT settings (if authentication is needed)
JWT_SECRET_KEY=your_very_secure_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# API Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=10

# Security headers
SECURE_HEADERS_ENABLED=true

# =============================================================================
# EMAIL CONFIGURATION (for notifications)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_USE_TLS=true

# Email settings
FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAILS=admin@yourdomain.com,alerts@yourdomain.com

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#data-pipeline
SLACK_USERNAME=DataPipeline Bot
SLACK_ENABLED=false

# Microsoft Teams (optional)
TEAMS_WEBHOOK_URL=your_teams_webhook_url_here
TEAMS_ENABLED=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development mode flags
DEV_MODE=true
AUTO_RELOAD=true
DEBUG_SQL=false
PROFILER_ENABLED=false

# Testing configuration
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/test_public_data
TEST_REDIS_URL=redis://localhost:6379/1

# Sample/Mock data settings
MOCK_DATA_ENABLED=false
SAMPLE_DATA_SIZE=100
FAKE_DATA_SEED=42

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Memory settings
MAX_MEMORY_USAGE=2GB
MEMORY_LIMIT_WARNING_THRESHOLD=80

# Processing settings
CHUNK_SIZE=10000
PARALLEL_PROCESSING=true
MAX_CONCURRENT_REQUESTS=10

# Cache settings
CACHE_ENABLED=true
CACHE_MAX_SIZE=1000
CACHE_EVICTION_POLICY=lru

# Query optimization
QUERY_TIMEOUT=300
CONNECTION_TIMEOUT=30
READ_TIMEOUT=60
WRITE_TIMEOUT=60

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Pipeline features
FEATURE_REAL_TIME_PROCESSING=false
FEATURE_ML_PREDICTIONS=false
FEATURE_AUTOMATED_REPORTING=true
FEATURE_DATA_LINEAGE=true

# API features  
FEATURE_API_VERSIONING=true
FEATURE_API_RATE_LIMITING=true
FEATURE_API_AUTHENTICATION=false

# Dashboard features
FEATURE_ADVANCED_VISUALIZATIONS=true
FEATURE_EXPORT_FUNCTIONALITY=true
FEATURE_USER_MANAGEMENT=false

# Data source features
FEATURE_IBGE_INTEGRATION=true
FEATURE_SICONV_INTEGRATION=true
FEATURE_MUNICIPAL_APIS=false
FEATURE_REAL_TIME_FEEDS=false

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker compose settings
COMPOSE_PROJECT_NAME=public-data-pipeline

# Container resource limits
POSTGRES_MAX_MEMORY=512m
REDIS_MAX_MEMORY=256m
APP_MAX_MEMORY=1g

# Volume mappings
HOST_DATA_DIR=./data
HOST_LOGS_DIR=./logs
HOST_CONFIG_DIR=./config

# =============================================================================
# CI/CD CONFIGURATION
# =============================================================================

# GitHub Actions
GITHUB_TOKEN=your_github_token_here
CODECOV_TOKEN=your_codecov_token_here

# Deployment settings
DEPLOYMENT_ENVIRONMENT=staging
DEPLOYMENT_BRANCH=main
AUTO_DEPLOYMENT=false

# Docker registry
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_TAG=latest
